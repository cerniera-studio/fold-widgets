<?xml version="1.0" encoding="utf-8"?>
<!-- Every widget is one picture drawn at its exact size, with invisible touch areas laid over
     the parts that act, and a progress line that can move without redrawing the picture.
     fitCenter, never fitXY: if the picture and the space ever disagree, it is scaled evenly,
     never stretched out of shape (31 Oct). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:clipToOutline="true">

    <!-- The finish behind a list fills the very box the head, rows and foot fill (27 Nov 2026).
         fitCenter had shrunk it when the launcher's space and the picture disagreed, leaving the
         date and rows standing past its edges. It carries no words over the list, so it is never
         a word that would stretch; and once the widget is measured the two agree exactly. -->
    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:indeterminate="false"
        android:max="1000"
        android:progressDrawable="@drawable/progress_line"
        android:visibility="gone" />


    <FrameLayout android:id="@+id/hit0" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit1" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit2" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit3" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit4" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit5" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit6" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit7" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit8" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit9" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit10" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />

    <FrameLayout android:id="@+id/hit11" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_gravity="top|start" android:background="@drawable/hit" android:visibility="gone" />


    <!-- The head (the date), the scrolling list and the foot (Momento's notes), stacked by the
         layout itself (22 Nov 2026), so the rows can never run over the date or under the notes,
         whatever size the launcher shows the picture at. Head and foot are pictures shown 1:1
         (matrix, never scaled); they take no touches, so the touch areas beneath still act. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/head"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="matrix"
            android:importantForAccessibility="no" />

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:listSelector="@android:color/transparent"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="22dp"
            android:cacheColorHint="@android:color/transparent" />

        <ImageView
            android:id="@+id/foot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="matrix"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
