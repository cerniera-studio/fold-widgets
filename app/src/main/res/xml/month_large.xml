<?xml version="1.0" encoding="utf-8"?>
<!-- Month · 4×3: The month with its name. A cover-screen cell is about 168 x 237 px. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="255dp"
    android:minHeight="267dp"
    android:minResizeWidth="72dp"
    android:minResizeHeight="72dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget"
    android:previewImage="@drawable/preview_month_full"
    android:description="@string/desc_month_43"
    android:configure="com.fergusonconsultancy.foldwidgets.ConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
