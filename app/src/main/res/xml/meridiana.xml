<?xml version="1.0" encoding="utf-8"?>
<!-- Meridiana · 3×3: a sundial with the real sun over the phone. Tall shapes look down on the dial,
     wide ones across the horizon. A cover-screen cell is about 168 x 237 px. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="190dp"
    android:minHeight="267dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="72dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget"
    android:previewImage="@drawable/preview_meridiana"
    android:description="@string/desc_meridiana"
    android:configure="com.fergusonconsultancy.foldwidgets.ConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
