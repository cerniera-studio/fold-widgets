<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather from Open-Meteo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Use my location" for the weather, asked only when that button is pressed -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Partenza (24 Nov 2026): re-checks while the app is closed start from where the phone is,
         once "Allow all the time" is chosen in Settings; otherwise from the last place seen -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- The agenda -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Glass: since Android 13 the wallpaper image is only readable with all-files access -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Refreshing the clock-bound widgets at midnight -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Momento's notes (22 Nov 2026): Nodo's most pressing knot, and the read you're partway through in Dorso -->
    <uses-permission android:name="com.cerniera.nodo.permission.NEXT" />
    <uses-permission android:name="com.cerniera.dorso.permission.READING" />

    <!-- Naming and opening whichever player is active -->
    <queries>
        <!-- Samsung Weather, opened by the weather widget -->
        <package android:name="com.sec.android.daemonapp" />
        <!-- Nodo, whose widget follows this app's look (Look.kt) -->
        <package android:name="com.cerniera.nodo" />
        <!-- Dorso, whose read in progress Momento's note carries on -->
        <package android:name="com.cerniera.dorso" />
        <!-- Riserva, whose gauge widget follows this app's look too (22 Nov 2026) -->
        <package android:name="com.cerniera.riserva" />
        <!-- Solco, whose still of itself is the glass's picture over it (27 Nov 2026) -->
        <package android:name="com.fergusonconsultancy.solco" />
        <!-- Every app that wears this look, found by its receiver (26 Nov 2026), so a new one needs no change here -->
        <intent>
            <action android:name="com.cerniera.LOOK_CHANGED" />
        </intent>
        <!-- Cielo, offered as what the weather widget opens -->
        <package android:name="com.fergusonconsultancy.cielo" />
        <!-- Solco, told when Copertina's colours change (26 Nov 2026) -->
        <package android:name="com.fergusonconsultancy.solco" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <!-- Home screens, so live mode knows the home screen is in front even when the launcher
             has no icon of its own (One UI Home, Pixel Launcher) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Music players: apps that offer a media library, and their media buttons (5 Nov 2026) -->
        <intent><action android:name="android.media.browse.MediaBrowserService" /></intent>
        <intent><action android:name="android.intent.action.MEDIA_BUTTON" /></intent>
        <!-- Icon packs, so app icons in the widgets match the home screen's -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by the launcher when a widget is placed or reconfigured: its finish -->
        <activity
            android:name=".ConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Every tap that opens something passes through here for a moment, so the widget learns
             where it sits on the screen (the glass needs that) before handing on -->
        <activity
            android:name=".TapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Pass" />

        <!-- Taps that act in place: play, skip, refresh -->
        <!-- The look (finish, corners, glass images), shared read-only with every family widget.
             The look itself is open; the glass's picture and the widgets' places are family only (Look.kt) -->
        <provider
            android:name=".LookProvider"
            android:authorities="com.fergusonconsultancy.foldwidgets.look"
            android:exported="true" />

        <!-- Partenza (24 Nov 2026): this app works out leave-by for the family; Fold Taskbar's Lume
             reads it here. Only Cerniera's own apps may read it (checked in the provider). -->
        <provider
            android:name="com.cerniera.kit.PartenzaProvider"
            android:authorities="com.cerniera.partenza"
            android:exported="true" />

        <!-- Copertina (26 Nov 2026): the sleeve's two colours while music plays, for Solco's sky.
             Only Cerniera's own apps may read it (checked in the provider). -->
        <provider
            android:name=".CopertinaProvider"
            android:authorities="com.cerniera.copertina"
            android:exported="true" />

        <receiver
            android:name=".TapReceiver"
            android:exported="false" />

        <!-- Solco saved a new still of itself: the glass redraws over it, and the family is told (27 Nov 2026) -->
        <receiver
            android:name=".SolcoStillReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cerniera.SOLCO_STILL" />
            </intent-filter>
        </receiver>

        <!-- Nodo and Dorso say something changed: Momento looks again (only ever a redraw) -->
        <receiver
            android:name=".MomentoRefresh"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cerniera.MOMENTO_REFRESH" />
                <!-- Partenza's leave-by changed -->
                <action android:name="com.cerniera.PARTENZA_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".Clockwork"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The music widget follows whatever is playing: Android only shows other apps' media
             sessions to an app with notification access. Nothing is read from the notifications. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".LiveService"
            android:exported="true"
            android:label="Fold Widgets live mode"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/live" />
        </service>

        <!-- The agenda's scrolling list: rows handed to the launcher one at a time -->
        <service
            android:name=".AgendaRows"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".RefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".MusicCompact" android:exported="false" android:label="Music">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/music_compact" />
        </receiver>
        <receiver android:name=".MusicSmall" android:exported="false" android:label="Music · Wide">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/music_small" />
        </receiver>
        <receiver android:name=".MusicLarge" android:exported="false" android:label="Music · Poster">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/music_large" />
        </receiver>
        <receiver android:name=".AgendaLarge" android:exported="false" android:label="Agenda · Detailed">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_large" />
        </receiver>
        <receiver android:name=".AgendaSmall" android:exported="false" android:label="Agenda · List">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_small" />
        </receiver>
        <receiver android:name=".WeatherSmall" android:exported="false" android:label="Weather · Today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_small" />
        </receiver>
        <receiver android:name=".WeatherLarge" android:exported="false" android:label="Weather · Forecast">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_large" />
        </receiver>
        <receiver android:name=".MonthSmall" android:exported="false" android:label="Month · Compact">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_small" />
        </receiver>
        <receiver android:name=".MonthLarge" android:exported="false" android:label="Month · Full">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_large" />
        </receiver>
        <!-- Fluido: one widget that becomes whichever widget the moment needs -->
        <receiver android:name=".MomentoWidget" android:exported="false" android:label="Momento">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/momento" />
        </receiver>
    </application>
</manifest>
